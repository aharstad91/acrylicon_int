{
  "name": "acrylicon-2024",
  "version": "1.0.0",
  "description": "Acrylicon WordPress theme with Tailwind CSS",
  "main": "custom-block-styles.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --watch",
    "dev": "npm run watch:css"
  },
  "keywords": [
    "wordpress",
    "theme",
    "tailwind"
  ],
  "author": "Andreas Harstad",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  }
}
